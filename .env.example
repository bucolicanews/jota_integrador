# Copie para .env.local (ou configure via Secret Manager em produção) -- nunca
# preencher valores reais aqui, este arquivo é versionado (docs/SEGURANCA.md).

# Supabase (local: valores impressos por `npx supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=[MASKED]
SUPABASE_SERVICE_ROLE_KEY=[MASKED]

# CORS -- lista separada por vírgula, sem protocolo/porta implícita omitida
APP_ALLOWED_ORIGINS=http://localhost:5173

PORT=3002

# Cofre de certificados digitais (Modo B, docs/SEGURANCA.md §1) -- 32 bytes base64,
# gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca reaproveitar entre ambientes, nunca versionar um valor real.
CERTIFICADO_CHAVE_MESTRA=[MASKED]

# SERPRO / Integra Contador (docs/SEGURANCA.md §3) -- trial não exige nenhuma das
# variáveis abaixo (token público, sem certificado); só produção exige.
SERPRO_AMBIENTE=trial
# SERPRO_TRIAL_TOKEN=      # opcional -- só se o SERPRO trocar o token público de demonstração
# SERPRO_CONSUMER_KEY=[MASKED]        # produção apenas
# SERPRO_CONSUMER_SECRET=[MASKED]     # produção apenas
# SERPRO_CERTIFICADO_PATH=            # produção apenas -- caminho pro .pfx/.p12 da Jota, NUNCA versionado
# SERPRO_CERTIFICADO_SENHA=[MASKED]   # produção apenas
# SERPRO_CONTRATANTE_CNPJ=            # produção apenas -- CNPJ da Jota
